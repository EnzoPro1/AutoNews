# Copie ce fichier en .env avant `docker compose up`.
POSTGRES_USER=veille
POSTGRES_PASSWORD=veille
POSTGRES_DB=veille

VEILLE_DATABASE_URL=postgresql+psycopg://veille:veille@db:5432/veille
